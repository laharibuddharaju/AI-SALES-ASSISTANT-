# =============================================================
# AI Sales Assistant — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit the .env file to version control.
# =============================================================

# ── Database ──────────────────────────────────────────────────
# SQLite (default, for local development):
DATABASE_URL=sqlite:///./aisales.db

# PostgreSQL (recommended for production):
# DATABASE_URL=postgresql://user:password@localhost:5432/aisales

# ── JWT Security ──────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_A_STRONG_RANDOM_SECRET_KEY

# Token expiry (in minutes / days)
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── HubSpot CRM ───────────────────────────────────────────────
# Get this from HubSpot → Settings → Integrations → Private Apps
HUBSPOT_API_KEY=

# ── OpenAI (for LLM intent classification) ────────────────────
# Get this from https://platform.openai.com/api-keys
# Leave empty to use regex-based fallback classification
OPENAI_API_KEY=

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_AUTH=10/minute
